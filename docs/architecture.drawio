ft=14;fillColor=#fff8ef;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1360" height="310" as="geometry"/></mxCell><mxCell id="rc" value="&lt;b&gt;routes/cards.py&lt;/b&gt;: /api/cards, the library&lt;br&gt;&lt;b&gt;routes/profiles.py&lt;/b&gt;: /api/profiles, boards" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="fl"><mxGeometry x="30" y="60" width="300" height="80" as="geometry"/></mxCell><mxCell id="rt" value='&lt;b&gt;routes/todos.py&lt;/b&gt;: /api/todos&lt;br&gt;todos of a card whose source is "todo"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="fl"><mxGeometry x="370" y="60" width="320" height="80" as="geometry"/></mxCell><mxCell id="rd" value="&lt;b&gt;routes/data.py: SERVICES&lt;/b&gt;&lt;br&gt;/api/data/&amp;lt;source&amp;gt;&lt;br&gt;source &amp;#8594; service.fetch()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2.5;strokeColor=#b85450;" vertex="1" parent="fl"><mxGeometry x="740" y="55" width="320" height="90" as="geometry"/></mxCell><mxCell id="err" value='&lt;b&gt;Error handlers&lt;/b&gt;&lt;br&gt;every error answers&lt;br&gt;{"error": message}' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="fl"><mxGeometry x="1100" y="60" width="230" height="80" as="geometry"/></mxCell><mxCell id="svc" value='&lt;b&gt;services/&lt;/b&gt;: weather.py, quotes.py, space.py&lt;br&gt;never raise: on failure, a fallback&lt;br&gt;flagged "fallback": true (ADR-009)' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="fl"><mxGeometry x="740" y="190" width="320" height="90" as="geometry"/></mxCell><mxCell id="hlp" value="&lt;b&gt;routes/helpers.py&lt;/b&gt;&lt;br&gt;JSON body and id checks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="fl"><mxGeometry x="1100" y="190" width="230" height="80" as="geometry"/></mxCell><mxCell id="e8" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="fl" source="rd" target="svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.4044;entryY=0;" edge="1" parent="1" source="vite" target="fl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt;: backend/instance/app.db&lt;br&gt;cards &amp;#8592; todos; profiles &amp;#8592; profile_cards &amp;#8594; cards (all ON DELETE CASCADE)&lt;br&gt;models/ (SQLAlchemy), migrations/ (Alembic)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="520" height="120" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;External APIs&lt;/b&gt;&lt;br&gt;Open-Meteo (weather), ZenQuotes (quote),&lt;br&gt;NASA APOD (space)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="905" width="320" height="90" as="geometry"/></mxCell><mxCell id="e10" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;