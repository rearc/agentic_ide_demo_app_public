<?xml version="1.0" encoding="UTF-8"?><mxfile host="drawio"><diagram name="Architecture"><mxGraphModel dx="1400" dy="1100" grid="0" pageWidth="1400" pageHeight="1100" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Dashboard: architecture&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="36" as="geometry"/></mxCell><mxCell id="sub" value="A personal grid of cards. React SPA, Flask API, SQLite. Paths are relative to &lt;i&gt;frontend/src/&lt;/i&gt; and &lt;i&gt;backend/app/&lt;/i&gt;." style="text;html=1;fontSize=14;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="26" as="geometry"/></mxCell><mxCell id="br" value="Browser: http://localhost:5173 (React SPA, frontend/src/)" style="swimlane;startSize=34;html=1;fontSize=14;fontStyle=1;rounded=1;arcSize=2;swimlaneLine=1;align=left;spacingLeft=14;fillColor=#f4f8fd;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1360" height="280" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;App.jsx&lt;/b&gt;&lt;br&gt;header: profile menu,&lt;br&gt;Library drawer, Customize, clock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="br"><mxGeometry x="30" y="60" width="210" height="90" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;components/Dashboard.jsx&lt;/b&gt;&lt;br&gt;the shown profile's grid;&lt;br&gt;useBoard.js owns and saves it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="br"><mxGeometry x="280" y="60" width="250" height="90" as="geometry"/></mxCell><mxCell id="card" value="&lt;b&gt;components/Card.jsx: CARD_REGISTRY&lt;/b&gt;&lt;br&gt;source &amp;#8594; widget, accent, needsData&lt;br&gt;unknown source: says which one" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2.5;strokeColor=#b85450;" vertex="1" parent="br"><mxGeometry x="570" y="55" width="300" height="100" as="geometry"/></mxCell><mxCell id="wid" value="&lt;b&gt;components/cards/&lt;/b&gt;&lt;br&gt;WeatherCard, QuoteCard, SpaceCard,&lt;br&gt;TodoCard, PlaceholderCard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="br"><mxGeometry x="910" y="60" width="420" height="90" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;api.js&lt;/b&gt;: the only module that calls fetch()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="br"><mxGeometry x="570" y="205" width="300" height="50" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;" edge="1" parent="1" source="app" target="dash"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;" edge="1" parent="1" source="dash" target="card"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#555555;fontColor=#333333;" edge="1" parent="1" source="card" target="wid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="needsData: /api/data/&amp;lt;source&amp;gt;" style="edgeStyle=orthogonalEdge